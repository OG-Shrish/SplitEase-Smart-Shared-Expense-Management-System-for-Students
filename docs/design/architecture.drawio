        <mxCell id="layer2" value="Application / Business Logic Tier (Express REST API)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontStyle=1;align=left;spacingLeft=10;fontSize=14;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="450" y="40" width="440" height="740" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="HTTP Server &amp; Middleware Gateway&#xa;• Express.js Server (Port 5000)&#xa;• CORS Policy &amp; Body Parser&#xa;• authMiddleware (JWT Token Validation &amp; Route Guard)&#xa;• Global Error Handling Middleware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;fontSize=12;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="45" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="authController &amp; authRoutes&#xa;• POST /api/auth/register (bcrypt 10 rounds)&#xa;• POST /api/auth/login (JWT Sign)&#xa;• GET /api/auth/me" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#166534;fontSize=11;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="155" width="400" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="groupController &amp; groupRoutes&#xa;• POST /api/groups (Create with Admin)&#xa;• GET /api/groups (User's Joined Groups)&#xa;• POST /api/groups/:id/members (Member Invites)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#166534;fontSize=11;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="235" width="400" height="65" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="expenseController &amp; expenseRoutes&#xa;• POST /api/expenses (Split calculation: Equal, Custom, %)&#xa;• Floating-point rounding discrepancy adjustment&#xa;• GET /api/expenses/group/:id (Chronological log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#166534;fontSize=11;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="315" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="balanceController (Debt Simplification Engine)&#xa;• GET /api/balances/group/:id (Raw net balance ledger)&#xa;• GET /api/balances/group/:id/simplify&#xa;  → Greedy Two-Pointer Algorithm (O(N log N))&#xa;  → Eliminates circular transactions to max N-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF08A;strokeColor=#CA8A04;fontColor=#713F12;fontStyle=1;fontSize=11;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="405" width="400" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="settlementController &amp; analyticsController&#xa;• POST /api/settlements (Mark Dues Completed)&#xa;• GET /api/analytics/group/:id (Category Breakdown)&#xa;• GET /api/analytics/group/:id/monthly (Spending Trends)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#166534;fontSize=11;" vertex="1" parent="layer2">
          <mxGeometry x="20" y="505" width="400" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Server Docker Container&#xa;• Port 5000 (Node.js 20 Express)&#xa;• Health check endpoint /" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;" vertex="1" parent="layer2">
